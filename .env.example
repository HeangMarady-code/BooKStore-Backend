# Database Configuration
# Full external connection URL (recommended for running locally against Render)
# e.g. postgresql://bookstore:PASSWORD@dpg-da2sehojo6nc738klvlg-a.REGION.postgres.render.com/book_store_xdbt
DATABASE_CONNECTION_URL=

# Individual components (used only if DATABASE_CONNECTION_URL is empty)
DATABASE_HOST=your-postgres-host
DATABASE_PORT=5432
DATABASE_NAME=book_store_xdbt
DATABASE_USER=bookstore
DATABASE_PASSWORD=your_database_password

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
APP_NAME=Book Store API
DEBUG=True